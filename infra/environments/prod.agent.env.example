# Hosted Agent configuration template, not an automatically loaded dotenv file.
# Resolve references with the approved deployment/secret mechanism; never commit rendered values.
# Production is independently scoped and remains undeployed.
ModelDeployment=gpt-4.1-mini
Orchestrator__SessionKeySalt=${KSFINANCE_PROD_SESSION_KEY_SALT}
Orchestrator__SessionTimeToLive=30.00:00:00
Orchestrator__SubagentTimeout=00:03:00
Orchestrator__MaxHistoryMessages=20
Orchestrator__LogSubagentText=false
Obo__ClientId=${KSFINANCE_PROD_BOT_APP_ID}
Obo__TenantId=${KSFINANCE_PROD_TENANT_ID}
Obo__Audience=${KSFINANCE_PROD_OBO_AUDIENCE}
Obo__ClientSecret=${KSFINANCE_PROD_BOT_CLIENT_SECRET}
Obo__UserTokenHeader=x-client-user-token
CopilotStudioAgent__EnvironmentId=${KSFINANCE_PROD_COPILOT_STUDIO_ENVIRONMENT_ID}
CopilotStudioAgent__SchemaName=${KSFINANCE_PROD_COPILOT_STUDIO_SCHEMA_NAME}
Fabric__SqlEndpoint=${KSFINANCE_PROD_FABRIC_SQL_ENDPOINT}
Fabric__Database=${KSFINANCE_PROD_FABRIC_DATABASE}
Fabric__WorkspaceId=${KSFINANCE_PROD_FABRIC_WORKSPACE_ID}
Fabric__DataAgentId=${KSFINANCE_PROD_FABRIC_DATA_AGENT_ID}
Fabric__SqlTimeout=00:00:20
Fabric__DataAgentTimeout=00:05:00
Resolver__SearchEndpoint=${KSFINANCE_PROD_SEARCH_ENDPOINT}
Resolver__SemanticConfigurationName=resolver-semantic
Resolver__EmbeddingEndpoint=${KSFINANCE_PROD_EMBEDDING_ENDPOINT}
# Index, catalogue version, embedding deployment and dimensions come from dbo.resolver_release.
Resolver__Timeout=00:00:20
Resolver__ClarificationTimeToLive=00:15:00
Resolver__MaxCandidates=8
